// The public site thesystemizedlife.com as a Cloudflare Worker with static assets (replaces GitHub Pages,
// so this repo can be private). Deploys from main through Cloudflare Workers Builds. See HOSTING.md.
{
  "name": "thesystemizedlife-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
